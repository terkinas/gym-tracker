# Copy this file to .env.local and fill in real values.

# Secret used to sign session cookies (HS256 JWT). Generate one with:
#   openssl rand -base64 32
# Required in production — the app throws on startup without it there.
# In development it falls back to an insecure built-in value so `npm run dev`
# works without any setup.
SESSION_SECRET=

# PostgreSQL connection string used by Prisma (prisma/schema.prisma reads it
# via env("DATABASE_URL")). Required in every environment, including
# development — there is no built-in fallback for this one.
# Example for a local Postgres instance:
#   DATABASE_URL=postgresql://user:password@localhost:5432/gymtracker?schema=public
# In Netlify, set this as a build/runtime environment variable instead of
# committing a real value here.
#
# Serverless note (Netlify): every warm function container opens its own
# Prisma connection pool, so many containers can exhaust a small database.
# If your provider offers a pooled endpoint (Neon "-pooler" host, Supabase
# pooler, pgbouncer), use it here. Prisma URL parameters you may need,
# depending on the provider (add only what your provider documents):
#   connection_limit=1   keep each container's pool small
#   pool_timeout=20      seconds to wait for a free connection
#   connect_timeout=15   seconds to wait when (re)connecting
#   pgbouncer=true       REQUIRED when the URL points at a pgbouncer
#                        transaction-mode pooler
# Providers that suspend/idle-close connections (e.g. Neon auto-suspend) will
# make Prisma log "Error in PostgreSQL connection: Error { kind: Closed }"
# when a pooled connection is dropped; Prisma then discards it and opens a
# new one. Set PRISMA_DEBUG=1 to also log how many PrismaClient instances a
# runtime creates (never logs secrets).
DATABASE_URL=
