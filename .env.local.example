# Copy this file to .env.local and fill in real values.

# Secret used to sign session cookies (HS256 JWT). Generate one with:
#   openssl rand -base64 32
# Required in production — the app throws on startup without it there.
# In development it falls back to an insecure built-in value so `npm run dev`
# works without any setup.
SESSION_SECRET=

# PostgreSQL connection string used by Prisma (prisma/schema.prisma reads it
# via env("DATABASE_URL")). Required in every environment, including
# development — there is no built-in fallback for this one.
# Example for a local Postgres instance:
#   DATABASE_URL=postgresql://user:password@localhost:5432/gymtracker?schema=public
# In Netlify, set this as a build/runtime environment variable instead of
# committing a real value here.
DATABASE_URL=
